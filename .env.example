# Copy this file to .env.local and fill in real values there.
# Never put real values in this file – it is committed to the repository.

# Neon Postgres connection string (dev branch for local development).
# Ask Niklas privately for the value.
DATABASE_URL=

# Emails (spec 004, decision 014). Without BREVO_API_KEY, local development prints each email
# (with its link) to the terminal instead of sending it.
# Brevo API key – ask the team privately for the value.
BREVO_API_KEY=
# The verified sender address in Brevo, e.g. team@example.com
EMAIL_FROM=
# The address of the site, used for links in emails, e.g. http://localhost:3000 or https://<project>.vercel.app
APP_URL=
